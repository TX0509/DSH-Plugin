{
  "name": "dsh-video-workbench",
  "version": "0.1.1",
  "description": "短视频制作工作台：agent 出片、HyperFrames 渲染、浮层预览与微调。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "scripts",
    "test",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "hyperframes"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.2.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --test",
    "check-selfcheck": "node scripts/check-selfcheck.mjs",
    "install-plugin": "node scripts/install.mjs",
    "uninstall-plugin": "node scripts/install.mjs --uninstall",
    "check-install": "node scripts/install.mjs --check"
  },
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
